# Ручной запуск закрытой демонстрации без Docker. Для постоянного хостинга
# используйте .env.hosting.example, compose.yaml и инструкцию DEPLOYMENT.md.
# Скопируйте в .env и заполните все обязательные поля.
# Это примеры адресов, а не опубликованный сайт. Реальные секреты в этот файл не добавляют.
# Запуск: node --env-file=.env server.mjs
GRAPH_MODE=demo

# Два разных HTTPS-хоста. Без завершающего /, пути, параметров или фрагмента.
APP_ORIGIN=https://classroom.example.org
RUNNER_ORIGIN=https://python.example.org

# Внутренние HTTP-порты. Прокси завершает TLS и сохраняет публичный Host.
PORT=4318
RUNNER_PORT=4319
GRAPH_BIND_HOST=127.0.0.1
# Не доверять заголовкам IP по умолчанию. Значение 1 допустимо только за
# закрытым прокси, который перезаписывает X-Graph-Client-IP (см. DEPLOYMENT.md).
GRAPH_TRUST_PROXY=0

# ОБЯЗАТЕЛЬНО: новый абсолютный путь в отдельной папке на постоянном диске.
# Не указывайте существующую локальную базу и не используйте временный диск контейнера.
# Пример для Linux, только после настройки постоянного хранения:
# GRAPH_DB=/var/lib/innovation/classroom.sqlite
# Пример формата Windows: GRAPH_DB=C:/InnovationDemoData/classroom.sqlite
GRAPH_DB=

# Дополнительный вход перед открытием платформы. Это НЕ пароль аккаунта ученика/учителя.
DEMO_USER=reviewer
# ОБЯЗАТЕЛЬНО замените пустое значение: отдельный пароль длиной 16–256 символов.
# Значение с # или пробелами заключите в кавычки. Никогда не публикуйте заполненный .env.
DEMO_PASSWORD=
# Альтернатива паролю в окружении: абсолютный путь к закрытому файлу.
# При использовании файла удалите DEMO_PASSWORD или оставьте его пустым.
# DEMO_PASSWORD_FILE=/etc/innovation/demo_password.txt
