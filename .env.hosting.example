# Copy to .env.hosting and replace all example values before deployment.
# Run Compose with: docker compose --env-file .env.hosting ...
# Two different DNS hostnames, without https://, ports, paths or trailing slash.
APP_HOST=classroom.example.com
RUNNER_HOST=python.example.com
# Address used by the certificate authority for operational notices.
ACME_EMAIL=admin@example.com

# This outer login is shared only with the two reviewers.
# It is separate from individual student/teacher accounts inside the platform.
DEMO_USER=reviewer
# Password is not an environment variable: place a random 32+ character value
# in secrets/demo_password.txt. Linux owner 1000:1000, mode 0400; directory 0700.

# Label local builds with a release tag/commit before updating.
IMAGE_TAG=local
# Name inside the persistent /data volume. Change after a verified restore to a NEW file.
DB_FILENAME=classroom.sqlite
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
